rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isWhitelistedTeacherEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/config/teacherWhitelist)
        && request.auth.token.email in get(/databases/$(database)/documents/config/teacherWhitelist).data.emails;
    }

    function isTeacher() {
      return hasUserDoc() && userData().role == 'teacher';
    }

    function isTeacherOwner(teacherId) {
      return isTeacher() && request.auth.uid == teacherId;
    }

    function isStudent() {
      return hasUserDoc() && userData().role == 'student';
    }

    function isStudentOwner(studentId) {
      return isStudent()
        && ('studentIds' in userData())
        && (studentId in userData().studentIds);
    }

    function isLinkedToTeacher(teacherId) {
      return isStudent()
        && ('teacherIds' in userData())
        && (teacherId in userData().teacherIds);
    }

    // Config: Teacher Whitelist
    // First-time setup: if teacherWhitelist doesn't exist yet, an authenticated user can seed it with ONLY their own email.
    // Afterwards, only existing teachers (or future admin) can read/update.
    match /config/teacherWhitelist {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/config/teacherWhitelist)
        && request.auth.token.email != null
        && request.resource.data.emails is list
        && request.resource.data.emails.size() == 1
        && request.auth.token.email in request.resource.data.emails;
      allow update: if isTeacher()
        && request.resource.data.emails is list
        && request.auth.token.email in request.resource.data.emails;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // Users can create their own user profile:
      // - teacher role ONLY if email is in config/teacherWhitelist
      // - student role for normal student login
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && (
          (request.resource.data.role == 'teacher' && isWhitelistedTeacherEmail())
          || (request.resource.data.role == 'student')
        );
      // Users cannot escalate their own role or tamper with linked studentIds/teacherIds directly
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('studentIds', []) == resource.data.get('studentIds', [])
        && request.resource.data.get('teacherIds', []) == resource.data.get('teacherIds', []);
    }

    // Teachers profile (public branding readable by linked students or authenticated users on invite landing)
    match /teachers/{teacherId} {
      allow read: if isTeacherOwner(teacherId) || isLinkedToTeacher(teacherId);
      allow create, update: if isTeacherOwner(teacherId)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // Students collection
    match /students/{studentId} {
      allow read: if (isTeacher() && (resource.data.teacherId == request.auth.uid || request.auth.uid in resource.data.get('teacherIds', [])))
        || isStudentOwner(studentId);
      allow create: if isTeacher()
        && request.resource.data.teacherId == request.auth.uid
        && request.auth.uid in request.resource.data.get('teacherIds', []);
      allow update: if isTeacher()
        && (resource.data.teacherId == request.auth.uid || request.auth.uid in resource.data.get('teacherIds', []))
        && request.resource.data.get('uid', null) == resource.data.get('uid', null);
      allow delete: if false;
    }

    // Teacher <-> Student Relationships
    match /relationships/{relId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || isStudentOwner(resource.data.studentId);
      allow create: if isTeacherOwner(request.resource.data.teacherId);
      allow update: if isTeacherOwner(resource.data.teacherId)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if false;
    }

    // Invitations (created & accepted via Cloud Functions; teacher can read status of their own invites)
    match /invitations/{token} {
      allow read: if isTeacherOwner(resource.data.teacherId);
      allow write: if false;
    }

    // Materials & Assignments
    match /materials/{materialId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || isLinkedToTeacher(resource.data.teacherId);
      allow create: if isTeacherOwner(request.resource.data.teacherId);
      allow update, delete: if isTeacherOwner(resource.data.teacherId);
    }

    match /materialAssignments/{assignId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || isStudentOwner(resource.data.studentId);
      allow create: if isTeacherOwner(request.resource.data.teacherId);
      allow update, delete: if isTeacherOwner(resource.data.teacherId);
    }

    // Attendance Sessions & Summaries
    match /attendanceSessions/{sessionId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || isStudentOwner(resource.data.studentId);
      allow create: if isTeacherOwner(request.resource.data.teacherId);
      allow update, delete: if isTeacherOwner(resource.data.teacherId);
    }

    match /attendanceSummaries/{summaryId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || isStudentOwner(resource.data.studentId);
      allow create: if isTeacherOwner(request.resource.data.teacherId);
      allow update: if isTeacherOwner(resource.data.teacherId);
      allow delete: if false;
    }

    // Offline Exams & Results
    match /offlineExams/{examId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || (isLinkedToTeacher(resource.data.teacherId) && resource.data.published == true);
      allow create: if isTeacherOwner(request.resource.data.teacherId);
      allow update, delete: if isTeacherOwner(resource.data.teacherId);
    }

    match /offlineResults/{resultId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || (isStudentOwner(resource.data.studentId) && resource.data.published == true);
      allow create: if isTeacherOwner(request.resource.data.teacherId)
        && request.resource.data.marksObtained >= 0
        && request.resource.data.marksObtained <= request.resource.data.totalMarks;
      allow update: if isTeacherOwner(resource.data.teacherId)
        && request.resource.data.marksObtained >= 0
        && request.resource.data.marksObtained <= request.resource.data.totalMarks;
      allow delete: if isTeacherOwner(resource.data.teacherId);
    }

    // Nano Library Questions
    // Platform questions: readable by teachers, writable by nobody on the client.
    // Teacher questions: readable & writable only by owning teacher.
    // Students NEVER read questions directly (served stripped via startNanoAttempt Cloud Function).
    match /questions/{questionId} {
      allow read: if isTeacher() && (
        resource.data.ownerType == 'platform'
        || (resource.data.ownerType == 'teacher' && resource.data.ownerId == request.auth.uid)
      );
      allow create: if isTeacher()
        && request.resource.data.ownerType == 'teacher'
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isTeacher()
        && resource.data.ownerType == 'teacher'
        && resource.data.ownerId == request.auth.uid;

      // Server-only answer key subcollection: students strictly denied.
      // Owning teachers may read/write answerKey for their own questions, and read platform answerKeys.
      match /private/answerKey {
        allow read: if isTeacher() && (
          get(/databases/$(database)/documents/questions/$(questionId)).data.ownerType == 'platform'
          || get(/databases/$(database)/documents/questions/$(questionId)).data.ownerId == request.auth.uid
        );
        allow create, update, delete: if isTeacher()
          && get(/databases/$(database)/documents/questions/$(questionId)).data.ownerType == 'teacher'
          && get(/databases/$(database)/documents/questions/$(questionId)).data.ownerId == request.auth.uid;
      }
    }

    // Nano Exams
    match /nanoExams/{examId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || (isLinkedToTeacher(resource.data.teacherId) && resource.data.status == 'published');
      allow create: if isTeacherOwner(request.resource.data.teacherId);
      allow update, delete: if isTeacherOwner(resource.data.teacherId);
    }

    // Nano Attempts (IMMUTABLE after creation; created exclusively by submitNanoAttempt Cloud Function)
    match /nanoAttempts/{attemptId} {
      allow read: if isTeacherOwner(resource.data.teacherId)
        || isStudentOwner(resource.data.studentId);
      allow create, update, delete: if false;
    }

    // Message Templates
    match /messageTemplates/{templateId} {
      allow read: if isTeacherOwner(resource.data.teacherId);
      allow create: if isTeacherOwner(request.resource.data.teacherId);
      allow update, delete: if isTeacherOwner(resource.data.teacherId);
    }
  }
}
